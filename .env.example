# Public browser configuration (safe to expose; use only the KANIRA Supabase project)
VITE_SUPABASE_URL=https://YOUR-KANIRA-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_KANIRA_SUPABASE_ANON_KEY

# Server-only secrets. NEVER prefix these with VITE_ and never expose them to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_KANIRA_SERVICE_ROLE_KEY
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Optional server-side email provider (choose provider before enabling transactional email)
# RESEND_API_KEY=
