# Browser-safe values: use ONLY the dedicated KANIRA Supabase project.
VITE_SUPABASE_URL=https://YOUR-KANIRA-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_KANIRA_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only secrets. Never prefix with VITE_ and never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_KANIRA_SERVICE_ROLE_KEY
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Optional; only configure after choosing a provider.
RESEND_API_KEY=
